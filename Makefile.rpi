# =========================================================================
# Raspberry Pi Specific Architecture Rules
# =========================================================================

# Raspberry Pi specific variables
KERNEL_FILE_arm64  := kernel8.img
KERNEL_FILE_armhf  := kernel.img

# DTB used by QEMU for raspi3b emulation (one per arch)
QEMU_DTB_arm64     := bcm2710-rpi-3-b-plus.dtb
QEMU_DTB_armhf     := bcm2708-rpi-zero-w.dtb

# =========================================================================
# Raspberry Pi Specific Architecture Rules Template
# =========================================================================
define RPI_ARCH_RULES
# $(1): Architecture (arm64, armhf)

image-$(1): target/$(1)/trimrouter.img

run-qemu-$(1): target/$(1)/trimrouter.img
	@echo "[qemu-rpi] Booting Raspberry Pi image ($(1)) under QEMU emulation..."
	@qemu-system-aarch64 \
	    -M raspi3b \
	    -cpu cortex-a53 \
	    -m 1024 \
	    -kernel target/$(1)/pi_boot/$(KERNEL_FILE_$(1)) \
	    -dtb target/$(1)/pi_boot/$(QEMU_DTB_$(1)) \
	    -initrd target/$(1)/pi_initramfs.cpio.gz \
	    -drive file=target/$(1)/trimrouter.img,if=sd,format=raw \
	    -device usb-net,netdev=lan0,mac=52:54:00:12:34:57 \
	    -netdev user,id=lan0 \
	    -append "console=ttyAMA0,115200 root=/dev/ram0 rdinit=/init quiet net.ifnames=0 dwc_otg.lpm_enable=0 dwc_otg.fiq_enable=0 dwc_otg.fiq_fsm_enable=0 trimrouter.lan_ip=192.168.1.1/24 trimrouter.wan_mac=52:54:00:12:34:56 trimrouter.lan_mac=52:54:00:12:34:57" \
	    -nographic

target/$(1)/trimrouter.img: target/$(RUST_TARGET_$(1))/release/trimrouter scripts/build_rpi_image.sh
	@./scripts/build_rpi_image.sh $(1)
endef

# Instantiate templates for Raspberry Pi
$(foreach arch,arm64 armhf,$(eval $(call RPI_ARCH_RULES,$(arch))))
