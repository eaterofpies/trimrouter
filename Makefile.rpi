# =========================================================================
# Raspberry Pi Specific Architecture Rules
# =========================================================================

# Raspberry Pi specific variables
KERNEL_FILE_arm64  := kernel8.img
KERNEL_FILE_armhf  := kernel.img

DTBS_arm64         := bcm2710-rpi-zero-2-w.dtb bcm2710-rpi-3-b-plus.dtb
DTBS_armhf         := bcm2708-rpi-zero-w.dtb

# Convenience defaults for Pi
image: image-arm64
run-qemu: run-qemu-arm64

# =========================================================================
# Raspberry Pi Specific Architecture Rules Template
# =========================================================================
define RPI_ARCH_RULES
# $(1): Architecture (arm64, armhf)

image-$(1): target/$(1)/rustyrouter.img

run-qemu-$(1): target/$(1)/rustyrouter.img
	@echo "[qemu-rpi] Booting Raspberry Pi image ($(1)) under QEMU emulation..."
	@qemu-system-aarch64 \
	    -M raspi3b \
	    -cpu cortex-a53 \
	    -m 1024 \
	    -kernel target/$(1)/pi_boot/$(KERNEL_FILE_$(1)) \
	    -dtb target/$(1)/pi_boot/$(firstword $(DTBS_$(1))) \
	    -initrd target/$(1)/pi_initramfs.cpio.gz \
	    -drive file=target/$(1)/rustyrouter.img,if=sd,format=raw \
	    -device usb-net,netdev=lan0,mac=52:54:00:12:34:57 \
	    -netdev user,id=lan0 \
	    -append "console=ttyAMA0,115200 root=/dev/ram0 rdinit=/init quiet net.ifnames=0 dwc_otg.lpm_enable=0 dwc_otg.fiq_enable=0 dwc_otg.fiq_fsm_enable=0 rustyrouter.lan_ip=192.168.1.1/24 rustyrouter.wan_mac=52:54:00:12:34:56 rustyrouter.lan_mac=52:54:00:12:34:57" \
	    -nographic

target/$(1)/rustyrouter.img: target/$(RUST_TARGET_$(1))/release/rustyrouter scripts/build_rpi_image.sh
	@./scripts/build_rpi_image.sh $(1)
endef

# Instantiate templates for Raspberry Pi
$(foreach arch,arm64 armhf,$(eval $(call RPI_ARCH_RULES,$(arch))))
