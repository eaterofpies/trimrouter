{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeAll"
  ],
  "platformAutomerge": true,
  "packageRules": [
    {
      "groupName": "all dependencies",
      "groupSlug": "all",
      "groupSingleUpdates": true,
      "matchPackageNames": [
        "*"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+?)\\s+depName=(?<depName>[^\\s]+?)(?:\\s+registryUrl=(?<registryUrl>[^\\s]+?))?(?:\\s+versioning=(?<versioning>[a-z-]+?))?\\nARG\\s+[A-Z_]+=\"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ]
}
